# =============================================================================
# HMD WA Gateway, environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` at the repo root (symlinked as
# apps/gateway/.env.local) for development. Set the same values in the Vercel
# project for Preview / Production. Every variable is validated at boot by
# apps/gateway/src/lib/env.ts (Zod). NEVER commit real secrets.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
GATEWAY_PUBLIC_URL=https://wa.example.com

# --- MongoDB (Atlas) ---------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=hmd_wa

# --- Upstash Redis -----------------------------------------------------------
UPSTASH_REDIS_URL=rediss://default:PASS@host.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://host.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# --- Cryptographic material (openssl rand -base64 32) ------------------------
SERVER_PEPPER=REPLACE_ME_BASE64_32B
INBOUND_ENCRYPTION_KEY=REPLACE_ME_BASE64_32B
WEBHOOK_SIGNING_DEFAULT_SECRET=REPLACE_ME_BASE64_32B
# Symmetric key for AES-256-GCM encryption of per-route webhook signing secrets at rest.
WEBHOOK_DELIVERY_KEY=REPLACE_ME_BASE64_32B
WORKER_WIRE_SECRET=REPLACE_ME_BASE64_32B

# --- Worker auth (RS256 JWT; PEM, newlines encoded as \n) --------------------
WORKER_JWT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WORKER_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- NextAuth (admin login) --------------------------------------------------
NEXTAUTH_URL=https://wa.example.com
NEXTAUTH_SECRET=REPLACE_ME_BASE64_32B

# --- Admin credentials (user:pass login) -------------------------------------
# JSON array of {email, hash}. Hash with:
#   node apps/gateway/scripts/hash-password.mjs "your-password"
ADMIN_CREDENTIALS=[{"email":"admin@example.com","hash":"scrypt$16384$8$1$...$..."}]

# --- WebAuthn (step-up for sensitive actions) --------------------------------
WEBAUTHN_RP_ID=wa.example.com
WEBAUTHN_RP_NAME=HMD WA Gateway

# --- Worker --------------------------------------------------------------------
WORKER_ID=primary

# --- Alerts (Resend) ---------------------------------------------------------
RESEND_API_KEY=re_REPLACE_ME
ALERTS_FROM_EMAIL=alerts@example.com

# --- Cron (required in production) -------------------------------------------
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` on each invocation.
# Required for /api/cron/* endpoints. If unset, cron endpoints are 401-only
# unless HMD_CRON_DEV_OPEN=1 is explicitly set (development bypass).
CRON_SECRET=REPLACE_ME_BASE64_32B
# HMD_CRON_DEV_OPEN=1   # uncomment in dev only; never set in production

# --- Origin enforcement -------------------------------------------------------
# Off (0) by default. Set to 1 only on a host that actually sits behind a proxy
# supplying a trusted peer-IP header (see apps/gateway/src/lib/cloudflare-ips.ts
# for the equivalent check): with it on, every request lacking that
# header is rejected with 403. Enabling this on a host without such a proxy in
# front of it will 403 every request, including your own.
ENFORCE_CLOUDFLARE_ORIGIN=0

# --- Trusted client IP header -------------------------------------------------
# Name of the header holding the real client IP, used for IP allowlists and
# per-IP rate limiting. No default: if left unset, every request resolves to
# the same 0.0.0.0 sentinel, so IP allowlists reject everything and per-IP
# rate limits share a single bucket. Only ever set this to a header that
# YOUR OWN reverse proxy overwrites/sets itself on every request, never one
# a client could send directly, or allowlisting and rate limiting become
# trivially spoofable. Examples: `cf-connecting-ip` behind Cloudflare,
# `x-real-ip` behind an nginx that sets it itself. See docs/SELF_HOSTING.md.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# Per-IP rate limit, requests/minute. Default 1200. Without
# TRUSTED_CLIENT_IP_HEADER set, every client shares the single 0.0.0.0
# bucket, so raise this rather than leaving the default in that case.
# RATE_LIMIT_IP_PER_MIN=1200

