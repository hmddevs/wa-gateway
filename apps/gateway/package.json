{
  "name": "@hmddevs/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "HMD WA Gateway, Next.js 15 HTTP API + admin dashboard.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm --filter @hmddevs/protocol build && SKIP_ENV_VALIDATION=1 next build",
    "start": "next start -p 3000",
    "lint": "next lint --dir src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hmddevs/protocol": "workspace:*",
    "@radix-ui/react-alert-dialog": "1.1.15",
