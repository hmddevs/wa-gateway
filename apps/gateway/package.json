    "jose": "5.9.6",
    "lucide-react": "0.512.0",
    "mongodb": "6.10.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "pino": "9.4.0",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "4.0.0",
    "shiki": "^1.29.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "1.0.7",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "3.23.8"
