{
  "name": "@hmddevs/worker",
  "version": "0.1.0",
  "private": true,
  "description": "HMD WA Baileys worker.",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "hmd-wa-baileys": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hmddevs/protocol": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "fastify": "5.8.5",
    "ioredis": "5.4.1",
    "pino": "9.4.0",
    "qrcode": "1.5.4",
    "undici": "6.27.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/qrcode": "1.5.5",
    "tsup": "8.2.4",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vitest": "2.1.3"
  }
}
