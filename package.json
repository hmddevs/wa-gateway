{
  "name": "hmd-wa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "HMD WhatsApp Gateway, self-hosted, hardened Baileys-backed messaging API.",
  "license": "MIT",
  "author": "HMD Developments <security@hmddevs.org>",
  "homepage": "https://github.com/hmddevs/wa-gateway",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmddevs/wa-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/hmddevs/wa-gateway/issues"
  },
  "engines": {
    "node": ">=20.0.0 <21",
    "pnpm": ">=10.0.0 <10.17"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r --filter='./packages/**' --filter='./apps/**' build",
    "dev:gateway": "pnpm --filter @hmddevs/gateway dev",
    "dev:worker": "pnpm --filter @hmddevs/worker dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:llms": "node scripts/check-llms-corpus.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "clean": "pnpm -r exec rm -rf dist .next .turbo node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ],
    "overrides": {
      "protobufjs": ">=7.6.1 <8.0.0",
      "ws": ">=8.21.0 <9.0.0",
      "axios": ">=1.15.2",
      "fast-uri": ">=3.1.2",
      "music-metadata": ">=11.12.3",
      "vitest": ">=2.1.9 <3.0.0",
      "js-cookie": ">=3.0.7"
    }
  }
}
