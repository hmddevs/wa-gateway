{
  "name": "@hmddevs/wa-sdk",
  "version": "0.3.0",
  "description": "Official client SDK for the HMD WhatsApp Gateway.",
  "license": "MIT",
  "author": "HMD Developments <security@hmddevs.org>",
  "homepage": "https://github.com/hmddevs/wa-gateway/tree/main/packages/sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmddevs/wa-gateway.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/hmddevs/wa-gateway/issues"
  },
  "keywords": [
    "whatsapp",
    "hmd",
    "messaging",
    "sdk",
    "baileys"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@hmddevs/protocol": "workspace:*",
    "tsup": "8.2.4",
    "typescript": "5.5.4",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
